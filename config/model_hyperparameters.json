{
  "xgboost_monotonic": {
    "description": "XGBoost with monotonic constraints for loan approval",
    "model_type": "XGBClassifier",
    "fixed_params": {
      "eval_metric": "logloss",
      "n_jobs": -1,
      "random_state": 42
    },
    "default_params": {
      "n_estimators": 350,
      "learning_rate": 0.05,
      "max_depth": 4,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "gamma": 0,
      "min_child_weight": 1,
      "reg_alpha": 0,
      "reg_lambda": 1
    },
    "monotonic_constraints": {
      "ApplicantIncome": 1,
      "CoapplicantIncome": 1,
      "LoanAmount": -1,
      "DTI": -1,
      "other_features": 0
    },
    "tuning_grid": {
      "n_estimators": [100, 200, 350, 500],
      "learning_rate": [0.01, 0.05, 0.1, 0.2],
      "max_depth": [3, 4, 5, 6],
      "subsample": [0.7, 0.8, 0.9, 1.0],
      "colsample_bytree": [0.7, 0.8, 0.9, 1.0],
      "gamma": [0, 0.1, 0.2, 0.5],
      "min_child_weight": [1, 3, 5, 7],
      "reg_alpha": [0, 0.01, 0.1, 1],
      "reg_lambda": [0.1, 1, 10, 100]
    },
    "tuning_strategy": "grid",
    "cv_folds": 5,
    "scoring_metric": "roc_auc"
  },
  "xgboost_baseline": {
    "description": "XGBoost without monotonic constraints (baseline comparison)",
    "model_type": "XGBClassifier",
    "fixed_params": {
      "eval_metric": "logloss",
      "n_jobs": -1,
      "random_state": 42
    },
    "default_params": {
      "n_estimators": 350,
      "learning_rate": 0.05,
      "max_depth": 4,
      "subsample": 0.9,
      "colsample_bytree": 0.9
    },
    "tuning_grid": {
      "n_estimators": [100, 200, 350, 500],
      "learning_rate": [0.01, 0.05, 0.1],
      "max_depth": [3, 4, 5, 6],
      "subsample": [0.8, 0.9, 1.0],
      "colsample_bytree": [0.8, 0.9, 1.0]
    },
    "tuning_strategy": "random",
    "n_iter": 50,
    "cv_folds": 5,
    "scoring_metric": "roc_auc"
  },
  "random_forest": {
    "description": "Random Forest baseline model",
    "model_type": "RandomForestClassifier",
    "fixed_params": {
      "random_state": 42,
      "n_jobs": -1
    },
    "default_params": {
      "n_estimators": 200,
      "max_depth": 10,
      "min_samples_split": 5,
      "min_samples_leaf": 2,
      "max_features": "sqrt"
    },
    "tuning_grid": {
      "n_estimators": [100, 200, 300],
      "max_depth": [5, 10, 15, 20],
      "min_samples_split": [2, 5, 10],
      "min_samples_leaf": [1, 2, 4],
      "max_features": ["sqrt", "log2"]
    },
    "tuning_strategy": "random",
    "n_iter": 30,
    "cv_folds": 5,
    "scoring_metric": "roc_auc"
  },
  "logistic_regression": {
    "description": "Logistic Regression baseline model",
    "model_type": "LogisticRegression",
    "fixed_params": {
      "random_state": 42,
      "max_iter": 1000,
      "n_jobs": -1
    },
    "default_params": {
      "C": 1.0,
      "penalty": "l2",
      "solver": "lbfgs"
    },
    "tuning_grid": {
      "C": [0.001, 0.01, 0.1, 1, 10, 100],
      "penalty": ["l1", "l2", "elasticnet"],
      "solver": ["lbfgs", "liblinear", "saga"]
    },
    "tuning_strategy": "grid",
    "cv_folds": 5,
    "scoring_metric": "roc_auc"
  }
}
