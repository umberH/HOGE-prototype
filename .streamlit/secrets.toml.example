# Streamlit Secrets Template
# Copy this configuration to Streamlit Cloud → Settings → Secrets
# DO NOT commit actual secrets to GitHub!

# ============================================================
# Neo4j Aura Configuration (Production)
# ============================================================
[neo4j]
uri = "neo4j+s://xxxxx.databases.neo4j.io"
user = "xxxxx"  # Usually same as instance ID
password = "your-aura-password-from-download"
database = "xxxxx"  # Same as instance ID (e.g., fc0456cc)

# ============================================================
# OpenAI API Configuration
# ============================================================
# NOTE: Users provide their own API keys via the UI!
# No OpenAI secrets needed in deployment.
# Each user enters their API key in the sidebar when using the app.

# ============================================================
# Deployment Mode
# ============================================================
# Set to "remote" for Streamlit Cloud (uses Neo4j Aura)
# Set to "local" for local development (uses localhost Neo4j)
USE_REMOTE_NEO4J = "remote"

# ============================================================
# Instructions:
# ============================================================
# 1. Go to your Streamlit Cloud app dashboard
# 2. Click ⋮ (three dots) → Settings
# 3. Click "Secrets" in the left sidebar
# 4. Paste this content (with your actual Neo4j credentials)
# 5. Replace the placeholder values:
#    - neo4j.uri: From Neo4j Aura download (e.g., neo4j+s://fc0456cc.databases.neo4j.io)
#    - neo4j.user: Usually same as instance ID (e.g., fc0456cc)
#    - neo4j.password: From Neo4j Aura download
#    - neo4j.database: Same as instance ID (e.g., fc0456cc)
# 6. Click "Save"
# 7. App will automatically restart
#
# Users will provide their own OpenAI API keys when using the app
