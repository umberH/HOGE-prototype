# Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================
# DEPLOYMENT MODE
# ============================================================
# Set to "local" or "remote" to switch between local and cloud Neo4j
USE_REMOTE_NEO4J=local

# ============================================================
# LOCAL NEO4J (for development)
# ============================================================
NEO4J_LOCAL_URI=neo4j://localhost:7687
NEO4J_LOCAL_USER=neo4j
NEO4J_LOCAL_PASSWORD=your_local_password
NEO4J_LOCAL_DATABASE=neo4j

# ============================================================
# REMOTE NEO4J AURA (for production)
# ============================================================
NEO4J_REMOTE_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_REMOTE_USER=neo4j
NEO4J_REMOTE_PASSWORD=your_aura_password
NEO4J_REMOTE_DATABASE=neo4j

# ============================================================
# OPENAI API
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# OPTIONAL: Model Configuration
# ============================================================
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
